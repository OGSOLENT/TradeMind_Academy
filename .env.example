# Firebase web app config — all values come from the Firebase console.
# Copy to .env.local (gitignored). Local dev + tests run against the
# Emulator Suite, so dummy values work until deployment.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=trademind-academy-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Set to "true" to connect the client SDK to the local emulator suite.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
