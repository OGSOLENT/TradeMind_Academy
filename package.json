{
  "name": "trademind-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:live": "node scripts/dev.mjs",
    "dev:emulator": "node scripts/dev-emulator.mjs",
    "build:emulator": "node scripts/prod-emulator.mjs build",
    "start:emulator": "node scripts/prod-emulator.mjs start",
    "stop": "lsof -ti:3000,3001,3002,3003,3100 | xargs kill 2>/dev/null; echo 'app servers stopped'",
    "stop:all": "lsof -ti:3000,3001,3002,3003,3100,8080,9099,9199,4000,4400 | xargs kill 2>/dev/null; sleep 2; lsof -ti:8080 | xargs kill 2>/dev/null; echo 'app servers and emulators stopped'",
    "db": "open https://console.firebase.google.com/project/trademind-academy/firestore",
    "db:local": "open http://localhost:4000/firestore",
    "users": "open https://console.firebase.google.com/project/trademind-academy/authentication/users",
    "build": "next build",
    "start": "next start",
    "live": "next build && next start -p 3000",
    "deploy": "node scripts/deploy.mjs",
    "deploy:preview": "node scripts/deploy.mjs --preview",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rules": "npx -y firebase-tools emulators:exec --only firestore --project demo-trademind \"vitest run --config vitest.rules.config.ts\"",
    "seed": "tsx scripts/seed.ts",
    "seed:live": "GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json GCLOUD_PROJECT=trademind-academy tsx scripts/seed.ts --allow-prod",
    "emulators": "npx -y firebase-tools emulators:start --project demo-trademind",
    "prepare": "husky",
    "analyse": "tsx scripts/analyse.ts",
    "analyse:live": "GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json GCLOUD_PROJECT=trademind-academy tsx scripts/analyse.ts --live",
    "simulate:routing": "tsx scripts/simulate-routing.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@tanstack/react-query": "^5.101.2",
    "firebase": "^12.16.0",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "lightweight-charts": "^5.2.0",
    "next": "14.2.25",
    "react": "^18",
    "react-dom": "^18",
    "three": "^0.170.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^8",
    "eslint-config-next": "14.2.25",
    "firebase-admin": "^14.1.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  }
}
