rules_version = '2';

// TradeMind Academy. Deny by default (BUILD_PROMPT sections 4 and 7.5).
// The response log is a research dataset, so responses are CREATE-ONLY. Always.
//
// Since the September audit the rules check WHAT is written as well as
// WHO writes it. Before, any signed-in learner could write any shape into
// their own documents from the browser console: a mastery of 1.0 on every
// module, or response rows with arbitrary fields. Now every document has an
// allow-list of keys, typed fields and ranges, and fields that record time
// must carry the server's clock rather than the client's.
//
// What rules cannot do is make a learner's answer TRUE: grading happens in
// the browser, so a determined participant could still log a correct
// answer they never gave. Closing that needs server-side grading (a Cloud
// Function), which the free Firebase plan does not offer; the report states
// it as a limitation, and the analysis derives mastery from the log rather
// than trusting the client-written mastery document.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isProb(v) {
      return v is number && v >= 0 && v <= 1;
    }

    // A field set with serverTimestamp() arrives as the request's own time.
    function isServerNow(v) {
      return v == request.time;
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---- The user subtree. Owner only. --------------------------------
    match /users/{uid} {
      function validSettings(s) {
        return s is map
          && s.keys().hasOnly(['theme', 'reducedMotion', 'colorBlindCandles', 'fontScale',
                               'highContrast', 'readableFont', 'comfortableReading', 'calmMode'])
          && s.theme == 'dark'
          && s.fontScale in [1, 1.15, 1.3];
      }

      function validConsent(c) {
        return c == null
          || (c is map && c.keys().hasOnly(['agreedAt', 'version'])
              && c.version is string && isServerNow(c.agreedAt));
      }

      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt', 'consent', 'isAdult', 'settings'])
        && request.resource.data.isAdult == true // 18+ is a hard gate, not a checkbox
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 200
        && isServerNow(request.resource.data.createdAt)
        && request.resource.data.consent == null
        && validSettings(request.resource.data.settings);
      // After sign-up a learner can give consent and change settings, and
      // nothing else: not the 18+ flag, not the sign-up date.
      allow update: if isOwner(uid)
        && changed().hasOnly(['displayName', 'consent', 'settings'])
        && (!('consent' in changed()) || validConsent(request.resource.data.consent))
        && (!('settings' in changed()) || validSettings(request.resource.data.settings))
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 200;
      allow delete: if isOwner(uid);

      // The mastery document is a cache of the response log
      // (lib/mastery/ledger.ts). Its shape is fixed here; the per-module
      // estimates live in a map the rules language cannot iterate, which is
      // one reason the analysis rebuilds mastery from the log instead.
      match /mastery/{courseId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['kcs', 'history', 'updatedAt', 'rebuiltAt'])
          && request.resource.data.kcs is map
          && request.resource.data.kcs.size() <= 64
          && request.resource.data.history is list
          && request.resource.data.history.size() <= 200
          && request.resource.data.updatedAt is timestamp
          && (!('rebuiltAt' in request.resource.data) || request.resource.data.rebuiltAt is timestamp);
      }

      match /sessions/{sid} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['type', 'startedAt', 'endedAt', 'kcIds', 'lessonId'])
          && request.resource.data.type in ['placement', 'post-test', 'topic-test', 'lesson-check', 'review']
          && isServerNow(request.resource.data.startedAt)
          && request.resource.data.endedAt == null
          && request.resource.data.kcIds is list
          && request.resource.data.kcIds.size() <= 64;
        // Closing a session, applying it to the model, or a repair
        // (lib/firebase/mastery.ts). The type, start time and scope are fixed.
        allow update: if isOwner(uid)
          && changed().hasOnly(['endedAt', 'score', 'masteryApplied', 'repairedAt'])
          && (!('endedAt' in changed()) || isServerNow(request.resource.data.endedAt))
          && (!('repairedAt' in changed()) || isServerNow(request.resource.data.repairedAt))
          && (!('masteryApplied' in changed()) || request.resource.data.masteryApplied is bool)
          && (!('score' in changed())
              || (request.resource.data.score.keys().hasOnly(['correct', 'total'])
                  && request.resource.data.score.correct is int
                  && request.resource.data.score.total is int
                  && request.resource.data.score.correct >= 0
                  && request.resource.data.score.correct <= request.resource.data.score.total));
        allow delete: if false;

        // The APPEND-ONLY research log (guardrail 7.2). A row has exactly
        // the fields the logger writes, estimates are probabilities, the
        // latency is not negative, the server stamps its own time, and it
        // must belong to a session that exists.
        match /responses/{rid} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
            && request.resource.data.keys().hasOnly(['itemId', 'kcId', 'questionType', 'correct', 'selected',
                                                     'latencyMs', 'pLBefore', 'pLAfter', 'ts', 'serverTs'])
            && request.resource.data.keys().hasAll(['itemId', 'kcId', 'questionType', 'correct',
                                                    'latencyMs', 'pLBefore', 'pLAfter', 'ts', 'serverTs'])
            && request.resource.data.itemId is string && request.resource.data.itemId.size() <= 120
            && request.resource.data.kcId is string && request.resource.data.kcId.size() <= 80
            && request.resource.data.questionType in ['mcq', 'multi', 'numeric', 'ordering', 'annotation', 'tf-confidence']
            && request.resource.data.correct is bool
            // No upper bound: a learner can leave a question open overnight,
            // and a real answer must never be refused for being slow.
            && request.resource.data.latencyMs is number
            && request.resource.data.latencyMs >= 0
            && isProb(request.resource.data.pLBefore)
            && isProb(request.resource.data.pLAfter)
            && request.resource.data.ts is number && request.resource.data.ts > 0
            && isServerNow(request.resource.data.serverTs)
            && exists(/databases/$(database)/documents/users/$(uid)/sessions/$(sid));
          allow update, delete: if false;
        }
      }

      // The end-of-study questionnaire (SUS + open answers). One doc, owner
      // only, and they can change their mind.
      match /surveys/{surveyId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['answers', 'score', 'comments', 'submittedAt'])
          && request.resource.data.answers is list
          && request.resource.data.answers.size() == 10
          && (request.resource.data.score == null
              || (request.resource.data.score is number
                  && request.resource.data.score >= 0 && request.resource.data.score <= 100))
          && request.resource.data.comments is map
          && isServerNow(request.resource.data.submittedAt);
      }
    }

    // ---- Content. Anyone signed in can read, only an admin claim can write. ----
    match /courses/{courseId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /kcs/{kcId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /lessons/{lessonId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /items/{itemId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
